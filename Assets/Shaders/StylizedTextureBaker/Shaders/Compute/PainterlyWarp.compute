#pragma kernel PainterlyWarp

Texture2D<float4> _SourceTex;
Texture2D<float2> _DirectionalField;
Texture2D<float4> _NoiseTex;

RWTexture2D<float4> _Output;

SamplerState sampler_linear_clamp;
SamplerState sampler_linear_repeat;

int _Resolution;
float _StrokeLength;
float _StrokeWidth;
float _FlowStrength;
float _ColorJitter;
float _SaturationBoost;
float _Opacity;

float3 RGBtoHSV(float3 c)
{
    float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = lerp(float4(c.bg, K.wz), float4(c.gb, K.xy), step(c.b, c.g));
    float4 q = lerp(float4(p.xyw, c.r), float4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

float3 HSVtoRGB(float3 c)
{
    float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * lerp(K.xxx, saturate(p - K.xxx), c.y);
}

float Hash(float2 p)
{
    float3 p3 = frac(float3(p.xyx) * float3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

[numthreads(8, 8, 1)]
void PainterlyWarp(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Resolution || (int)id.y >= _Resolution) return;

    float2 uv = ((float2)id.xy + 0.5) / (float)_Resolution;
    float2 flowDir = _DirectionalField[id.xy] * 2.0 - 1.0;
    float flowLen = length(flowDir);

    if (flowLen > 0.01)
        flowDir /= flowLen;
    else
        flowDir = float2(1, 0);

    float4 color = float4(0, 0, 0, 0);
    float totalWeight = 0.0;
    int sampleCount = (int)_StrokeLength;

    for (int i = -sampleCount; i <= sampleCount; i++)
    {
        float2 offset = flowDir * (float)i * _FlowStrength / (float)_Resolution;
        float2 sampleUV = saturate(uv + offset);

        float weight = exp(-0.5 * (float)(i * i) / max(_StrokeWidth * _StrokeWidth, 0.01));
        color += _SourceTex.SampleLevel(sampler_linear_clamp, sampleUV, 0) * weight;
        totalWeight += weight;
    }

    color /= max(totalWeight, 0.001);

    float3 hsv = RGBtoHSV(color.rgb);
    float noise = Hash(id.xy * 0.37);
    hsv.x = frac(hsv.x + (noise - 0.5) * _ColorJitter);
    hsv.y = saturate(hsv.y * _SaturationBoost);
    color.rgb = HSVtoRGB(hsv);

    float noiseDetail = _NoiseTex.SampleLevel(sampler_linear_repeat, uv * 5.13, 0).r;
    color.rgb = lerp(color.rgb, color.rgb * lerp(0.95, 1.05, noiseDetail), 0.3);

    _Output[id.xy] = float4(color.rgb, _Opacity);
}
